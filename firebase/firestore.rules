rules_version = '2';

// A urna acessa o Firestore pelo Firebase Admin SDK (conta de serviço), que NÃO passa por estas
// regras. Por isso bloqueamos todo acesso vindo de apps/navegadores: ninguém de fora lê ou altera
// os dados usando só o ID do projeto.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
