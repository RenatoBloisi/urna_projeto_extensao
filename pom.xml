<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.com.urnacidada</groupId>
    <artifactId>urna-projeto-extensao</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>Urna Cidadã</name>
    <description>Simulação educativa do voto eletrônico (JavaFX + Firebase Cloud Firestore)</description>

    <properties>
        <!-- Tudo em Java 17 -->
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <javafx.version>17.0.13</javafx.version>
        <firebase.admin.version>9.4.3</firebase.admin.version>
        <slf4j.version>2.0.16</slf4j.version>

        <!-- Classe que abre o programa (NÃO estende Application; evita o erro
             "JavaFX runtime components are missing") -->
        <main.class>br.com.urnacidada.view.app.Launcher</main.class>
    </properties>

    <dependencies>
        <!-- JavaFX 17 (as bibliotecas nativas do seu sistema são escolhidas automaticamente) -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Firebase Admin SDK: traz o Cloud Firestore e a autenticação por conta de serviço -->
        <dependency>
            <groupId>com.google.firebase</groupId>
            <artifactId>firebase-admin</artifactId>
            <version>${firebase.admin.version}</version>
        </dependency>

        <!-- Log simples no console (o Firebase/gRPC usam SLF4J) -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>

            <!-- Abrir a urna:  mvn javafx:run -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                </configuration>
            </plugin>

            <!-- Cadastrar os candidatos no Firestore:  mvn compile exec:java -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>br.com.urnacidada.service.CadastrarCandidatos</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
